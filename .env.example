# Copy to .env and replace the JWT secret with a private random value (32+ UTF-8 bytes).
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# MongoDB connection and database name
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=agrovision

# Final Colab artifact and its matching sidecars. Do not point this at the historical H5.
AGROVISION_MODEL_PATH=backend/models/final_efficientnetv2b0_eca.keras
AGROVISION_MODEL_LABELS_PATH=backend/models/class_labels.json
AGROVISION_PREPROCESSING_CONFIG=backend/models/preprocessing_config.json
AGROVISION_MODEL_VERSION=efficientnetv2b0-eca-final

# Backend origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=25000000
UNCERTAINTY_THRESHOLD=0.60
UNCERTAINTY_MARGIN=0.03
